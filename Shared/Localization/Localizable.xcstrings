      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the loop between your intention and your experience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra el ciclo entre tu intención y tu experiencia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让晨间意图与今天的真实经历形成闭环。"
          }
        }
      }
    },
    "Cierra los ojos y respira profundo... Acalla tus pensamientos y solo siente tu respiración. Eres importante, este momento es tuyo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close your eyes and breathe deeply... Let your thoughts grow quiet and simply feel your breath. You matter; this moment is yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra los ojos y respira profundo... Acalla tus pensamientos y solo siente tu respiración. Eres importante, este momento es tuyo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闭上眼睛，深深呼吸……让思绪慢慢安静，只去感受呼吸。你很重要，这一刻属于你。"
          }
        }
      }
    },
