    "Exceso frecuente de ultraprocesados, azúcar, sal y grasas saturadas puede aumentar fatiga, apetito desregulado y riesgo de enfermedades crónicas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequent excess intake of ultra-processed foods, sugar, salt, and saturated fat may increase fatigue, disrupt appetite, and raise the risk of chronic disease."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exceso frecuente de ultraprocesados, azúcar, sal y grasas saturadas puede aumentar fatiga, apetito desregulado y riesgo de enfermedades crónicas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经常过量摄入超加工食品、糖、盐和饱和脂肪，可能增加疲劳、食欲紊乱和慢性疾病风险。"
          }
        }
      }
