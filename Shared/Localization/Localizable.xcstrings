    "Hay conflictos con datos locales. No se sobrescribe nada sin confirmación." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are conflicts with local data. Nothing will be overwritten without confirmation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地数据存在冲突。未经确认，任何内容都不会被覆盖。"
          }
        }
      }
    },
    "Hay evidencia suficiente para clasificarlo como ecológico según señales de certificación regional." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is sufficient evidence to classify it as organic based on regional certification signals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay evidencia suficiente para clasificarlo como ecológico según señales de certificación regional."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据地区认证信息，有充分依据将其判定为有机产品。"
          }
        }
      }
    },
    "Hay peligro inmediato o sientes que podrías hacerte daño o dañar a otra persona." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is immediate danger, or you feel you may harm yourself or someone else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay peligro inmediato o sientes que podrías hacerte daño o dañar a otra persona."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在眼前的危险，或你觉得自己可能会伤害自己或他人。"
          }
        }
      }
    },
    "Hay pocos días con registros. Prueba una pausa breve a media mañana y otra al final de la tarde para empezar a revelar tu patrón." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a few days have entries. Try a short pause in mid-morning and another late in the afternoon to begin revealing your pattern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay pocos días con registros. Prueba una pausa breve a media mañana y otra al final de la tarde para empezar a revelar tu patrón."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前只有少数几天有记录。试着在上午中段和傍晚各停顿片刻，开始看见自己的规律。"
          }
        }
      }
    },
    "Hay señales parciales de producto ecológico, pero falta evidencia robusta de certificación oficial." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
