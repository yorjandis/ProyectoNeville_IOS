    "Cuenta cuántas entradas fueron creadas en cada día de la semana usando la fecha de creación.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts how many entries were created on each day of the week using their creation date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta cuántas entradas fueron creadas en cada día de la semana usando la fecha de creación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据创建日期，统计一周中每天创建的日记数量。"
          }
        }
      }
    },
    "Cuenta los días consecutivos en los que alcanzaste el mínimo de retornos conscientes definido para sostener la racha.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts consecutive days when you reached the minimum number of conscious returns required to maintain your streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta los días consecutivos en los que alcanzaste el mínimo de retornos conscientes definido para sostener la racha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计连续达到最低觉察次数、从而维持连续记录的天数。"
          }
        }
      }
    },
    "Cuenta los momentos de presencia consciente registrados desde el inicio del día actual.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts the conscious moments of presence recorded since the start of today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta los momentos de presencia consciente registrados desde el inicio del día actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计从今天开始到现在记录的有意识回到当下的时刻。"
          }
        }
      }
    },
