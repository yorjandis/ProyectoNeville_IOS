        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已经练习了新的回应。重要的是练习，而不是完美。"
          }
        }
      }
    },
    "Has tomado una sobredosis, una sustancia peligrosa o has sufrido una lesión importante." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
