        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要试图消除情绪，而要避免让情绪自动变成行为。"
          }
        }
      }
    },
    "No necesitas creer una afirmación grandiosa; necesitas una instrucción practicable." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
