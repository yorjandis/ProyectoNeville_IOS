    "1: mínimamente procesado • 2: ingrediente culinario • 3: procesado • 4: ultraprocesado" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1: unprocessed/minimally processed • 2: processed culinary ingredient • 3: processed • 4: ultra-processed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1: mínimamente procesado • 2: ingrediente culinario • 3: procesado • 4: ultraprocesado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1：未加工或最低限度加工 • 2：加工烹饪原料 • 3：加工食品 • 4：超加工食品"
