          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个具体、可观察的行为。工具会通过引导练习、P.A.R.A.、日志和评估陪伴你完成过程。"
          }
        }
      }
    },
    "Elige un foco realista para la próxima semana." : {
