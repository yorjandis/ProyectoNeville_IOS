    "Prioriza alimentos frescos o mínimamente procesados (NOVA 1-2), listas cortas de ingredientes y pocos aditivos de riesgo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose fresh or minimally processed foods (NOVA 1–2), short ingredient lists, and few potentially harmful additives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioriza alimentos frescos o mínimamente procesados (NOVA 1-2), listas cortas de ingredientes y pocos aditivos de riesgo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先选择新鲜或低度加工食品（NOVA 1–2）、配料表较短且潜在风险添加剂较少的产品。"
          }
        }
