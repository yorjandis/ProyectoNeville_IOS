          "stringUnit" : {
            "state" : "translated",
            "value" : "重复会把意图转化为真实经验。"
          }
        }
      }
    },
    "La respuesta de OpenFoodFacts no se pudo procesar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
