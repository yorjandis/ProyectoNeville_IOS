    "El Diario le permite llevar un registro de las actividades y hechos del día. Está protegido y solo usted tiene acceso.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Journal lets you keep a record of the day's activities and events. It is protected and only you can access it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Diario le permite llevar un registro de las actividades y hechos del día. Está protegido y solo usted tiene acceso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日记可用于记录当天的活动和事件。内容受到保护，只有你可以访问。"
          }
        }
      }
    },
