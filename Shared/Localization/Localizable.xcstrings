    "Más alto significa que, entre los eventos registrados, hubo más retornos conscientes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher value means that more of the recorded events were conscious returns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alto significa que, entre los eventos registrados, hubo más retornos conscientes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值越高，表示记录的事件中有意识回到当下的比例越高。"
          }
        }
      }
    },
