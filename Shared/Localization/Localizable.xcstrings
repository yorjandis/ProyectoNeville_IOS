            "value" : "一天中做五次简短的身体扫描。"
          }
        }
      }
    },
    "Haz de tres a seis respiraciones lentas y nombra la emoción." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take three to six slow breaths and name the emotion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz de tres a seis respiraciones lentas y nombra la emoción."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做三到六次缓慢呼吸，并说出这种情绪。"
          }
        }
      }
    },
    "Haz más difícil la conducta antigua y más sencilla la nueva." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make the old behavior harder and the new one easier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz más difícil la conducta antigua y más sencilla la nueva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让旧行为更难发生，让新行为更容易执行。"
          }
        }
      }
    },
