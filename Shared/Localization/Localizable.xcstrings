            "value" : "目标结束条件："
          }
        }
      }
    },
    "La meta todavía no ha comenzado, así que también puedes corregir su unidad de medida." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goal hasn't started yet, so you can also correct its unit of measurement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比赛尚未开始，因此您也可以更正其计量单位。"
          }
        }
      }
    },
    "La migración exporta, de manera segura y cifrada, los siguientes datos:" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migration securely exports the following data in encrypted form:"
