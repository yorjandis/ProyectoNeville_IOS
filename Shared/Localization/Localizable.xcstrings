          }
        }
      }
    },
    "Concentración baja suele asociarse a menor saciedad y peor salud digestiva. Buena o alta favorece salud metabólica e intestinal." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low levels are often linked to less satiety and poorer digestive health. Good or high levels support metabolic and gut health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentración baja suele asociarse a menor saciedad y peor salud digestiva. Buena o alta favorece salud metabólica e intestinal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含量偏低往往意味着饱腹感较弱、消化健康较差；含量良好或较高有利于代谢和肠道健康。"
          }
        }
      }
    },
    "Concentración media" : {
      "extractionState" : "stale",
