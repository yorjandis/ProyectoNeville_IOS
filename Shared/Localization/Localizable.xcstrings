    "El piloto automático se repite esta semana: elige una señal concreta —una alarma, una respiración o una frase— antes de tu momento más vulnerable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autopilot has repeated this week. Choose a clear cue—an alarm, a breath, or a phrase—before your most vulnerable moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El piloto automático se repite esta semana: elige una señal concreta —una alarma, una respiración o una frase— antes de tu momento más vulnerable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这周“自动驾驶”状态反复出现。请在最容易失去觉察的时刻之前，设置一个明确提示——闹钟、一次呼吸，或一句话。"
          }
        }
      }
    },
