        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知权限尚未开启。你可以在系统设置中启用。"
          }
        }
      }
    },
    "Los servicios pueden cambiar. Comprueba siempre el país, el propósito y la fuente antes de llamar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
