    "Los 21 días avanzan desde observar el patrón hasta consolidar una identidad basada en conducta." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The 21 days progress from observing the pattern to consolidating a behavior-based identity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los 21 días avanzan desde observar el patrón hasta consolidar una identidad basada en conducta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
