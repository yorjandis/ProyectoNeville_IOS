    "Antes de actuar, imagina durante diez segundos las consecuencias de segundo orden." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before acting, spend ten seconds imagining the second-order consequences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de actuar, imagina durante diez segundos las consecuencias de segundo orden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行动前，用十秒钟想一想更长远的后果。"
          }
        }
      }
    },
    "Antes de comenzar" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before you begin"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de comenzar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始之前"
          }
        }
      }
    },
    "Antes de continuar, respira durante un minuto y registra cómo estás. Después decide la siguiente acción más pequeña que sí puedas sostener." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before continuing, breathe for one minute and record how you feel. Then choose the smallest next action you can realistically sustain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de continuar, respira durante un minuto y registra cómo estás. Después decide la siguiente acción más pequeña que sí puedas sostener."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续之前，先呼吸一分钟并记录此刻的状态。然后选择一个你确实能够坚持的最小行动。"
          }
        }
      }
    },
    "Antes de dormir, habita el resultado" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before sleep, dwell in the fulfilled outcome."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de dormir, habita el resultado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入睡前，让自己进入愿望已经实现的状态。"
          }
        }
      }
    },
    "Antes de empezar, vuelve a ti" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before you begin, return to yourself"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de empezar, vuelve a ti"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始之前，先回到自己"
          }
        }
      }
    },
    "Antes de una dificultad manejable, prepara desencadenante, señal, pensamiento, pausa, conducta alternativa y criterio de detención." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before a manageable challenge, prepare for the trigger, signal, thought, pause, alternative behavior, and stopping rule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de una dificultad manejable, prepara desencadenante, señal, pensamiento, pausa, conducta alternativa y criterio de detención."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面对一个可承受的挑战前，提前准备好诱因、信号、想法、暂停方式、替代行为和停止标准。"
          }
        }
      }
    },
    "Antes del primer momento que suele llevarte al piloto automático, haz una pausa de tres respiraciones y recuerda tu identidad elegida." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before the first moment that usually sends you into autopilot, pause for three breaths and remember your chosen identity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes del primer momento que suele llevarte al piloto automático, haz una pausa de tres respiraciones y recuerda tu identidad elegida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在第一个容易让你进入“自动驾驶”的时刻之前，停下来呼吸三次，并想起你为今天选择的身份。"
          }
        }
      }
    },
    "Antes del sueño, vuelve a la imagen cumplida" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before sleep, return to the fulfilled image."
