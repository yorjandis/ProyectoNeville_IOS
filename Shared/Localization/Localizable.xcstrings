        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你觉察到 %lld 次自动驾驶状态。觉察本身，就是回归当下。"
          }
        }
      }
    },
    "Detén cualquier ejercicio si aumenta el malestar, aparece dolor, mareo intenso o dificultad para respirar. Respira con normalidad y busca ayuda si lo necesitas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop any exercise if distress increases or you develop pain, severe dizziness, or difficulty breathing. Breathe normally and seek help if you need it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detén cualquier ejercicio si aumenta el malestar, aparece dolor, mareo intenso o dificultad para respirar. Respira con normalidad y busca ayuda si lo necesitas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果练习让你更加不适，或出现疼痛、严重眩晕、呼吸困难，请立即停止。恢复自然呼吸，并在需要时寻求帮助。"
          }
        }
      }
    },
