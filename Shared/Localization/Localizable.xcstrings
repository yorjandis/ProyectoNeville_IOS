    "Aún no hay suficientes registros en este rango. Haz uno o dos retornos conscientes hoy para que aparezca un patrón útil.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are not enough entries in this range yet. Make one or two conscious returns today so a useful pattern can begin to emerge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes registros en este rango. Haz uno o dos retornos conscientes hoy para que aparezca un patrón útil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个时间范围内的记录还不够。今天有意识地回到当下一两次，让有用的规律逐渐显现。"
          }
        }
      }
    },
