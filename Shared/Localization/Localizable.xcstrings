    "Despliega una explicación biológica más detallada" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expand a more detailed biological explanation"
          }
        },
        "es" : {
          "stringUnit" : {
