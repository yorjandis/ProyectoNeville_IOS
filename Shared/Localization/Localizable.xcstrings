          }
        }
      }
    },
    "Elige un comportamiento concreto y observable. La herramienta te acompañará con práctica guiada, P.A.R.A., diario y medición." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose one specific, observable behavior. The tool will guide you through practice, P.A.R.A., journaling, and measurement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
