    "Sal mayor de 1.5 g por 100 g: se recomienda vigilar su consumo y no exceder 5 g de sal al día, salvo pérdida elevada por sudoración excesiva." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than 1.5 g of salt per 100 g: monitor intake and do not exceed 5 g of salt per day, except when excessive sweating causes significant losses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal mayor de 1.5 g por 100 g: se recomienda vigilar su consumo y no exceder 5 g de sal al día, salvo pérdida elevada por sudoración excesiva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每 100 克含盐超过 1.5 克：建议控制摄入量，每日盐摄入不超过 5 克；大量出汗导致盐分明显流失时除外。"
          }
        }
      }
    },
