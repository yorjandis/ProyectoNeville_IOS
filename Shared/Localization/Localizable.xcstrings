    "Azúcar entre 5 g y 15 g por 100 g: se recomienda moderar su consumo en grandes cantidades o con frecuencia." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Between 5 g and 15 g of sugar per 100 g: avoid large portions or frequent consumption."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azúcar entre 5 g y 15 g por 100 g: se recomienda moderar su consumo en grandes cantidades o con frecuencia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每 100 克含糖 5–15 克：建议避免大量或频繁食用。"
          }
        }
      }
    },
    "Azúcar mayor de 15 g por 100 g: se recomienda evitar su consumo por su mayor impacto metabólico." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than 15 g of sugar per 100 g: avoiding consumption is recommended because of its greater metabolic impact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azúcar mayor de 15 g por 100 g: se recomienda evitar su consumo por su mayor impacto metabólico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每 100 克含糖超过 15 克：由于对代谢影响较大，建议避免食用。"
          }
        }
      }
    },
    "Azúcares libres/añadidos: menos del 10 por ciento de las calorías; idealmente menos del 5 por ciento si es posible." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free/added sugars: less than 10 percent of calories; ideally less than 5 percent where possible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azúcares libres/añadidos: menos del 10 por ciento de las calorías; idealmente menos del 5 por ciento si es posible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游离糖/添加糖应低于总热量的百分之十；条件允许时最好低于百分之五。"
          }
        }
      }
    },
