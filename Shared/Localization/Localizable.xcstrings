    "Hoy eliges tu estado interno y comportamiento. No serás un efecto de tu entorno.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today you choose your inner state and behavior. You will not be shaped by your surroundings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
