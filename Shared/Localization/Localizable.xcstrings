    "Cada amanecer puede reeducar tu mente" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every sunrise can retrain your mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada amanecer puede reeducar tu mente"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个清晨都能重新塑造你的心智。"
          }
        }
      }
    },
    "Cada anillo representa el porcentaje de una emoción sobre el total de entradas registradas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each ring represents one emotion's percentage of all recorded entries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada anillo representa el porcentaje de una emoción sobre el total de entradas registradas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个圆环表示某种情绪在全部日记中的占比。"
          }
        }
      }
    },
    "Cada año en esta fecha:" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every year on this date:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每年这一天："
          }
        }
      }
    },
    "Cada día, a esta hora:" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day at this time:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天这个时间："
          }
        }
      }
    },
    "Cada dimensión aporta hasta 2 puntos." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each dimension is worth up to 2 points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dimensión aporta hasta 2 puntos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个维度最高 2 分。"
          }
        }
      }
    },
    "Cada latido es una puerta\nhacia tu equilibrio natural" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each heartbeat is a doorway\nto your natural balance"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada latido es una puerta\nhacia tu equilibrio natural"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次心跳都是一道门，\n通往你自然的平衡"
          }
        }
      }
    },
    "Cada mes en esta fecha:" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every month on this date:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月这一天："
          }
        }
      }
    },
    "Cada noche es una oportunidad de crear" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every night is an opportunity to create."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada noche es una oportunidad de crear"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个夜晚都是一次创造的机会。"
          }
        }
      }
    },
    "Cada pausa es una puerta a otro estado" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every pause is a doorway to a different state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pausa es una puerta a otro estado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次停顿，都是通往另一种状态的门。"
          }
        }
      }
    },
    "Cada punto representa el porcentaje de eventos conscientes frente al total de eventos conscientes e inconscientes de ese día, dentro del rango elegido en esta tarjeta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each dot represents the percentage of conscious events out of all conscious and unconscious events for that day in the selected range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada punto representa el porcentaje de eventos conscientes frente al total de eventos conscientes e inconscientes de ese día, dentro del rango elegido en esta tarjeta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个点表示所选时间范围内，当天觉察事件占全部觉察与无意识事件的比例。"
          }
        }
      }
    },
    "Cada punto representa un día. Puedes cambiar el rango a 7, 15, 30, 45, 60 o 90 días para analizar tu ritmo de escritura." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each dot represents one day. Change the range to 7, 15, 30, 45, 60, or 90 days to explore your writing rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada punto representa un día. Puedes cambiar el rango a 7, 15, 30, 45, 60 o 90 días para analizar tu ritmo de escritura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个点代表一天。你可以切换为 7、15、30、45、60 或 90 天，观察自己的写作节奏。"
          }
        }
      }
    },
    "Cada repetición correcta es evidencia, aunque la emoción siga presente." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every successful repetition is evidence, even when the emotion is still present."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repetición correcta es evidencia, aunque la emoción siga presente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次正确练习都是证据，即使情绪仍然存在。"
          }
        }
      }
    },
    "Cada respiración me devuelve a un estado de equilibrio." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each breath returns me to a state of balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada respiración me devuelve a un estado de equilibrio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次呼吸都带我回到平衡。"
          }
        }
      }
    },
    "Cada toque es una interrupción amable del viejo hábito y una elección deliberada de identidad." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each tap gently interrupts the old habit and becomes a deliberate choice of identity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada toque es una interrupción amable del viejo hábito y una elección deliberada de identidad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次轻触，都是对旧习惯的一次温柔打断，也是对理想自我的一次有意识选择。"
          }
        }
      }
    },
