    },
    "Prioriza alimentos frescos o mínimamente procesados (NOVA 1-2), listas cortas de ingredientes y pocos aditivos de riesgo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose fresh or minimally processed foods (NOVA 1–2), short ingredient lists, and few potentially harmful additives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioriza alimentos frescos o mínimamente procesados (NOVA 1-2), listas cortas de ingredientes y pocos aditivos de riesgo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先选择新鲜或低度加工食品（NOVA 1–2）、配料表较短且潜在风险添加剂较少的产品。"
          }
        }
      }
    },
    "Prioriza las grasas no saturadas y los alimentos menos procesados." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose unsaturated fats and less processed foods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioriza las grasas no saturadas y los alimentos menos procesados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先选择不饱和脂肪和加工程度较低的食品。"
          }
        }
      }
    },
    "Prioriza opciones con menor azúcar total." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose options with less total sugar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioriza opciones con menor azúcar total."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先选择总糖含量较低的产品。"
          }
        }
      }
    },
    "Prioriza opciones con menor azúcar, especialmente para consumo frecuente." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose lower-sugar options, especially for frequent consumption."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioriza opciones con menor azúcar, especialmente para consumo frecuente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尤其是经常食用时，应优先选择糖含量较低的产品。"
          }
        }
      }
    },
    "PRO" : {
