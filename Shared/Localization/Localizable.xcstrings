    },
    "Haz una sesión breve de coherencia y elige un gesto visible que exprese la identidad que quieres sostener hoy." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do a brief coherence session, then choose one visible action that expresses the identity you want to embody today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una sesión breve de coherencia y elige un gesto visible que exprese la identidad que quieres sostener hoy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
