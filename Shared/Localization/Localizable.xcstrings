    "solo miraré un momento por si hay algo importante" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will only check for a moment in case something important came in"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "solo miraré un momento por si hay algo importante"
          }
        },
