    "Un patrón puede aliviar, proteger o dar control a corto plazo. Reconocer esa recompensa permite cambiarlo." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pattern may provide short-term relief, protection, or control. Recognizing that reward makes change possible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un patrón puede aliviar, proteger o dar control a corto plazo. Reconocer esa recompensa permite cambiarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个模式可能会在短期内带来缓解、保护感或控制感。看见这种回报，才有可能改变它。"
          }
        }
      }
    },
