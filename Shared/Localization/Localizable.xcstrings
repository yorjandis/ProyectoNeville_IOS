    "Guías prácticas premium" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium practical guides"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guías prácticas premium"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级实用引导"
          }
        }
      }
    },
    "Guías rápidas para momentos difíciles: ansiedad, miedo, estrés, bloqueo, conflicto o impulso. Comprende qué ocurre en tu cuerpo y aplica técnicas prácticas paso a paso cuando más lo necesitas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick guides for difficult moments such as anxiety, fear, stress, feeling stuck, conflict, or strong urges. Understand what is happening in your body and follow practical techniques step by step when you need them most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guías rápidas para momentos difíciles: ansiedad, miedo, estrés, bloqueo, conflicto o impulso. Comprende qué ocurre en tu cuerpo y aplica técnicas prácticas paso a paso cuando más lo necesitas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在焦虑、害怕、压力、卡住、冲突或冲动等艰难时刻，为你提供快速引导。了解身体正在发生什么，并在最需要时一步步练习实用方法。"
          }
        }
      }
    },
