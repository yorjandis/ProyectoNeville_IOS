    },
    "Elige la experiencia que más se parece a lo que estás viviendo. Primero comprobaremos la seguridad y después te guiaremos paso a paso." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the experience that best matches what you are going through. We will check your safety first, then guide you step by step."
          }
