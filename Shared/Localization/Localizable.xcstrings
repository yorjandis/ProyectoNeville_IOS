          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara frecuencia, intensidad, detección, pausas, respuestas alternativas, recuperación, consecuencias y confianza entre el inicio y hoy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对比开始时与现在的频率、强度、觉察速度、暂停次数、替代反应、恢复时间、后果和信心。"
          }
        }
      }
    },
