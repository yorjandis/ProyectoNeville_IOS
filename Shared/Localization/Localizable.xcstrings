          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "情绪可以存在，但不必变成行为。"
          }
        }
      }
    },
    "La emoción que estás dispuesto a tolerar" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The emotion you are willing to tolerate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La emoción que estás dispuesto a tolerar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你愿意容纳的情绪"
          }
        }
      }
    },
    "La energía media es baja: usa la preparación nocturna para reducir fricción y proteger el inicio de mañana." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average energy is low. Use your evening preparation to reduce friction and protect tomorrow’s start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La energía media es baja: usa la preparación nocturna para reducir fricción y proteger el inicio de mañana."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均精力偏低。利用晚间准备减少阻力，让明天更顺利地开始。"
          }
        }
      }
    },
    "La entrada de Diario no se pudo crear; puedes guardar esta reflexión manualmente." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Journal entry could not be created; you can save this reflection manually."
