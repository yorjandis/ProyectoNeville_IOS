        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅会每年自动续订，直到你取消为止。"
          }
        }
      }
    },
    "La voz y el archivo de audio se generan íntegramente en el dispositivo." : {
      "localizations" : {
