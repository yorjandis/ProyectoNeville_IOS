    "Cada anillo representa el porcentaje de una emoción sobre el total de entradas registradas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each ring represents one emotion's percentage of all recorded entries."
          }
        },
