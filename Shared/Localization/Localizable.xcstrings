    "Prueba a registrar un instante de presencia mañana, sin exigencias." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try recording one moment of presence tomorrow, with no pressure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba a registrar un instante de presencia mañana, sin exigencias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明天不妨轻松地记录一次回到当下的时刻。"
          }
        }
      }
    },
    "Prueba con palabras como miedo, trabajo, dudas, enfado o ansiedad." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try words such as fear, work, doubt, anger, or anxiety."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba con palabras como miedo, trabajo, dudas, enfado o ansiedad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以试试“害怕”“工作”“疑虑”“生气”或“焦虑”等词。"
          }
        }
      }
    },
    "Prueba una técnica de otra familia o busca apoyo humano. No es necesario repetir un ejercicio que no te ayuda." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try a different type of technique or seek support from another person. You do not need to repeat an exercise that does not help you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba una técnica de otra familia o busca apoyo humano. No es necesario repetir un ejercicio que no te ayuda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以换一种类型的练习，或向身边的人寻求支持。没有帮助的练习，不必勉强重复。"
          }
        }
      }
    },
    "Puedes actualizar la identidad y la planificación futura. El progreso ya registrado no cambiará." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can update your identity and future planning. Any progress already recorded will not change."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以更新您的身份信息和未来规划。已记录的任何进度都不会改变。"
          }
        }
      }
    },
