          "stringUnit" : {
            "state" : "translated",
            "value" : "你正在忆起，\n超越念头之后的自己"
          }
        }
      }
    },
    "Este día responde a tu nueva identidad" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This day responds to your new identity."
          }
