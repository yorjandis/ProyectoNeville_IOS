    "Esta comprobación evita tratar automáticamente como emocional algo que podría necesitar ayuda urgente." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This check helps avoid treating something as purely emotional when it may require urgent help."
          }
        },
        "es" : {
          "stringUnit" : {
