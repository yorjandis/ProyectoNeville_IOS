    "Detectaste %lld momento%@ de piloto automático. Detectarlo ya es volver." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You noticed %lld autopilot moment%@. Noticing it is already a return."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectaste %lld momento%@ de piloto automático. Detectarlo ya es volver."
