    "Analiza cualquier alimento y obtiene información nutricional detallada: consumo saludable, impacto en el metabolismo y posibles efectos negativos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyze any food and get detailed nutritional information: healthy consumption, metabolic impact, and possible adverse effects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza cualquier alimento y obtiene información nutricional detallada: consumo saludable, impacto en el metabolismo y posibles efectos negativos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析各种食品，获取详细营养信息，包括健康食用建议、对新陈代谢的影响以及可能的不良作用。"
