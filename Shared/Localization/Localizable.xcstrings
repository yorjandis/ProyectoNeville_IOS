    "Diseña tu día con claridad e intención." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design your day with clarity and intention."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseña tu día con claridad e intención."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带着清晰与意图规划你的一天。"
          }
        }
      }
    },
    "Diseña tu mañana con intención, registra tu presencia, cierra el día con aprendizaje y transforma todo en un Diario útil para mañana. Incluye recordatorios, estadísticas y Mi día." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start your morning with intention, track your presence, end the day with learning, and turn it all into a useful journal for tomorrow. Includes reminders, statistics, and My Day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseña tu mañana con intención, registra tu presencia, cierra el día con aprendizaje y transforma todo en un Diario útil para mañana. Incluye recordatorios, estadísticas y Mi día."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以明确的意图开启早晨，记录你的当下感受，以收获结束一天，并将一切整理成对明天有用的日记。包含提醒、统计数据和“我的一天”。"
          }
        }
      }
    },
