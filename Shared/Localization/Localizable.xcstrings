            "value" : "含量适中"
          }
        }
      }
    },
    "Concentración y salud" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentration and Health"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentración y salud"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含量与健康"
          }
        }
      }
    },
    "Concentraciones altas aumentan carga glucémica y exceso calórico. Se recomienda mantenerla baja, especialmente en ultraprocesados." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High levels increase glycemic load and excess calorie intake. Keeping them low is recommended, especially in ultra-processed foods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentraciones altas aumentan carga glucémica y exceso calórico. Se recomienda mantenerla baja, especialmente en ultraprocesados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含量过高会增加血糖负荷和热量摄入，尤其在超加工食品中应尽量保持较低水平。"
          }
        }
      }
    },
    "Concentraciones altas elevan riesgo de hipertensión en consumo habitual. Es preferible una concentración baja." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular consumption at high levels increases the risk of high blood pressure. A low concentration is preferable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentraciones altas elevan riesgo de hipertensión en consumo habitual. Es preferible una concentración baja."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长期摄入较高含量会增加高血压风险，宜选择含量较低的产品。"
          }
        }
      }
    },
    "Concentraciones altas y frecuentes se asocian a mayor riesgo cardiovascular. Conviene priorizar niveles bajos o moderados." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequent high intake is associated with greater cardiovascular risk. Low or moderate levels are preferable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentraciones altas y frecuentes se asocian a mayor riesgo cardiovascular. Conviene priorizar niveles bajos o moderados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经常摄入较高含量与心血管风险增加有关，宜优先选择低至中等含量。"
          }
        }
      }
    },
