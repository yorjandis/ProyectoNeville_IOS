    "Traza la cadena antigua y después una alternativa: desencadenante → pensamiento → emoción → impulso → conducta → consecuencias → identidad reforzada." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Map the old chain and then an alternative: trigger → thought → emotion → urge → behavior → consequences → reinforced identity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traza la cadena antigua y después una alternativa: desencadenante → pensamiento → emoción → impulso → conducta → consecuencias → identidad reforzada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画出旧链条，再写出替代链条：诱因 → 想法 → 情绪 → 冲动 → 行为 → 后果 → 被强化的身份认同。"
          }
        }
      }
    },
