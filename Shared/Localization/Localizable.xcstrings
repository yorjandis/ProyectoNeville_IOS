    "Visualiza un episodio leve, uno moderado y uno intenso. En cada uno practica señal, pausa, emoción, frase operativa y respuesta alternativa." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualize a mild, moderate, and intense episode. In each one, practice the cue, pause, emotion, actionable phrase, and alternative response."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualiza un episodio leve, uno moderado y uno intenso. En cada uno practica señal, pausa, emoción, frase operativa y respuesta alternativa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想象一个轻度、中度和高强度的情境，并在每个情境中练习识别信号、暂停、容纳情绪、使用行动语句和替代反应。"
          }
        }
      }
    },
