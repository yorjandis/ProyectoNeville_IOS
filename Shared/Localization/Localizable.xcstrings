    "Momento del día" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time of day"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momento del día"
          }
        },
        "zh-Hans" : {
