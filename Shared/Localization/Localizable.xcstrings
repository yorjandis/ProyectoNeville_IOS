    "OpenRouter · Modelos gratuitos" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenRouter · Free models"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
