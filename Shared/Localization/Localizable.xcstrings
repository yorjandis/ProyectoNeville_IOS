            "value" : "法律——目标"
          }
        }
      }
    },
    "La Ley - Objetivos" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ley - Goals"
          }
        },
        "es" : {
          "stringUnit" : {
