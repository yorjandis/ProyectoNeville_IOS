    "Tienes dolor o presión intensa o nueva en el pecho, te has desmayado o te cuesta mucho respirar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have severe or new chest pain or pressure, you have fainted, or you are having serious difficulty breathing."
          }
        },
