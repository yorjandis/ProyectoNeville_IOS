    "Clasifica el entorno según favorezca el patrón antiguo, el nuevo o sea neutral. Realiza tres cambios concretos." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classify your environment by whether it supports the old pattern, the new one, or neither. Make three concrete changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasifica el entorno según favorezca el patrón antiguo, el nuevo o sea neutral. Realiza tres cambios concretos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "判断环境中的因素是在支持旧模式、新模式，还是保持中立，并做出三个具体改变。"
          }
        }
      }
    },
