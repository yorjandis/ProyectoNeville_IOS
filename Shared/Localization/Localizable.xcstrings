    "presence.insights.critical_window": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autopilot is most concentrated between {0} and {1}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre {0} y {1} se concentra más piloto automático."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动驾驶模式最集中在{0}至{1}之间。"
          }
        }
      }
    },
    "presence.insights.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated using the last {0} days selected on this card.\n\nMost present day: the day with the highest number of conscious returns.\nDaily average: total conscious returns divided by the number of days in the range.\nWeekly trend: the latest 7 days compared with the previous 7.\nCritical window: the 3-hour block with the most Autopilot or Distracted entries.\nContextual suggestion: a brief recommendation based on time concentration, the balance between presence and autopilot, and the recent trend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se calculan con los últimos {0} días seleccionados en esta tarjeta.\n\nDía con más presencia: día con mayor número de retornos conscientes.\nPromedio por día: total de retornos conscientes dividido entre los días del rango.\nTendencia semanal: últimos 7 días comparados con los 7 días anteriores.\nFranja crítica: bloque de 3 horas con más registros de Piloto automático o Distraído.\nSugerencia contextual: recomendación breve derivada de concentración horaria, equilibrio entre presencia/piloto automático y tendencia reciente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据此卡片中选择的最近{0}天计算。\n\n觉察最多的一天：有意识回到当下次数最多的一天。\n每日平均：回到当下的总次数除以所选天数。\n每周趋势：最近7天与之前7天的对比。\n需留意时段：记录“自动驾驶模式”或“分心”最多的连续3小时。\n情境建议：根据记录集中的时间、觉察与自动驾驶模式的平衡，以及近期趋势给出的简短建议。"
          }
        }
      }
    },
