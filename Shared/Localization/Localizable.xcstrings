        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traza la cadena antigua y después una alternativa: desencadenante → pensamiento → emoción → impulso → conducta → consecuencias → identidad reforzada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
