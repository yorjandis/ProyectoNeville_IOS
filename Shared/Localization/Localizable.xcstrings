          }
        }
      }
    },
    "Antes del primer momento que suele llevarte al piloto automático, haz una pausa de tres respiraciones y recuerda tu identidad elegida.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before the first moment that usually sends you into autopilot, pause for three breaths and remember your chosen identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes del primer momento que suele llevarte al piloto automático, haz una pausa de tres respiraciones y recuerda tu identidad elegida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在第一个容易让你进入“自动驾驶”的时刻之前，停下来呼吸三次，并想起你为今天选择的身份。"
          }
        }
      }
    },
