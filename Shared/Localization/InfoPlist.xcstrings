    },
    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ley needs access to your music library so you can choose custom music in Calm Space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ley necesita acceso a tu biblioteca musical para que puedas seleccionar música personalizada en Espacio Calma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ley 需要访问你的音乐资料库，以便你在“平静空间”中选择自己的音乐。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is required to scan QR codes, labels, and text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso a la cámara para escanear códigos QR, etiquetas y texto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用相机来扫描二维码、标签和文字。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to protect and unlock your journal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID para proteger y abrir tu Diario."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用面容 ID 保护并打开你的日记。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ley uses heart rate, heart-rate variability, breathing, steps, and workout data to estimate physiological activation and show stress patterns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ley usa tus datos de pulso, variabilidad cardiaca, respiración, pasos y entrenamientos para estimar tu activación fisiológica y mostrarte patrones de estrés."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ley 会使用你的心率、心率变异性、呼吸、步数和锻炼数据，估算生理唤醒程度并呈现压力变化规律。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ley uses your location to capture the current address and save it to Agenda activities or Notes when you request it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ley usa tu ubicación para capturar la dirección actual y guardarla en actividades de Agenda o en Notas cuando lo solicites."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你主动使用此功能时，La Ley 会根据你的位置获取当前地址，并将其保存到日程活动或笔记中。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access is needed to save images you create."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a Fotos para guardar las imágenes que crees."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问照片，才能保存你创建的图片。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access is needed so you can choose images for your content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a Fotos para que puedas elegir imágenes para tu contenido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问照片，以便你为内容选择图片。"
          }
        }
      }
    },
    "NSSiriUsageDescription" : {
      "comment" : "Privacy - Siri Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri handles requests to create journal entries, notes, and quotes in La Ley."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri procesa las peticiones para crear entradas en el Diario, nuevas notas y frases en La Ley."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 可在 La Ley 中根据你的请求创建日记、笔记和语录。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}